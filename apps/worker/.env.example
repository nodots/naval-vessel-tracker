DATABASE_URL=postgres://kenr@localhost:5433/naval_tracker_dev

# Tick interval in milliseconds. Defaults to 30000 (per spec §9).
# POLL_INTERVAL_MS=30000

# Which AIS source to use. One of: mock | aisstream | barentswatch.
# Default: mock — synthetic data, no external dependencies.
AIS_SOURCE=mock

# --- aisstream.io (https://aisstream.io) -------------------------------
# Free WebSocket feed, global coverage, requires an API key.
# As of 2026-05-21 their stream.aisstream.io TLS cert is expired; mock or
# barentswatch are more reliable until they renew.
AISSTREAM_API_KEY=

# --- barentswatch.no (https://developer.barentswatch.no) ---------------
# Free REST/SSE feed, Norwegian economic zone + Svalbard/Jan Mayen.
# Register an account at https://www.barentswatch.no/minside, create an
# API client with the 'ais' scope, and paste the credentials below.
# OAuth client_credentials flow — no user interaction needed at runtime.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
