{
  "name": "@naval-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate && node scripts/fix-postgis-types.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:positions": "tsx src/db/seed-positions.ts",
    "db:seed:mmsi": "tsx src/db/seed-mmsi.ts",
    "db:seed:norway": "tsx src/db/seed-norway-vessels.ts",
    "db:seed:russia": "tsx src/db/seed-russia-vessels.ts",
    "db:studio": "drizzle-kit studio",
    "osint:sweep": "tsx src/osint/sweep.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@naval-tracker/shared": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
