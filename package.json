{
  "name": "naval-vessel-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Naval vessel tracker — monorepo root",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
